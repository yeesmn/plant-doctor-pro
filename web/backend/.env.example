# --------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
#
# This file holds the SERVICE-ROLE key, which bypasses row-level security.
# It must stay server-side: never copy it into web/frontend/.env, never
# prefix it with VITE_, never ship it to a browser.
# --------------------------------------------------------------------

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Project Settings → API → service_role secret.
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY
