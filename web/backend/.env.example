# --------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
#
# This file holds the SERVICE-ROLE key, which bypasses row-level security.
# It must stay server-side: never copy it into web/frontend/.env, never
# prefix it with VITE_, never ship it to a browser.
# --------------------------------------------------------------------

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Project Settings → API → service_role secret.
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Shared secret the Arduino sends as the X-Device-Secret header on every POST.
# Must match DEVICE_SECRET in arduino/plant_doctor_pro/config.h exactly.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Writes are refused without it: 503 when unset, 401 when it does not match.
DEVICE_SECRET=YOUR_DEVICE_SECRET
