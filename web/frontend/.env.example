# --------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored.
#
# Vite exposes every VITE_*-prefixed variable to the browser bundle, so
# only values that are safe to ship to a client belong here. The Supabase
# service-role key must NEVER appear in this file — it lives in
# web/backend/.env.
# --------------------------------------------------------------------

# Supabase project URL and the PUBLISHABLE (anon) key — both are safe in a
# browser; row-level security is what restricts access. Project Settings →
# API in the Supabase dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# true  → render 90 days of synthetic readings; no Supabase, no login
# false → live data from Supabase (RLS limits it to the logged-in user)
VITE_USE_MOCK=false
